# Everything here is optional. With no values set, the app uses the local
# JSON store at data/queue.json (seeded from data/seed.json on first run).

# Shared secret that agents must send as the `x-queue-api-secret` header on
# POST /api/queue and PATCH /api/queue/:id. Leave empty for local development.
QUEUE_API_SECRET=

# Optional Supabase store. When both URL and key are set, the app reads and
# writes the table below instead of the JSON file. Run docs/supabase.sql first.
# The key is a server-side secret (service role). Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_QUEUE_TABLE=queue_items
